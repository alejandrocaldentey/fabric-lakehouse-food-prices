	/// Consumer food price change minus farm-gate price change. Positive means consumers paid more than the farm-gate change explains.
	column food_price_gap_pp
		dataType: double
		isHidden
		lineageTag: 566f4b3a-a74e-5de0-bf4c-de483bd6f576
		sourceLineageTag: food_price_gap_pp
		summarizeBy: none
		sourceColumn: food_price_gap_pp

		annotation SummarizationSetBy = Automatic

	/// Consumer food price change this year per point of farm-gate change last year. Undefined when last year's farm-gate change was under 1 point, where the ratio explodes.
	column pass_through_ratio_lag1
		dataType: double
		isHidden
		lineageTag: 895ce82c-7401-5a66-9d2d-d723b172ef7f
		sourceLineageTag: pass_through_ratio_lag1
