		sourceColumn: pass_through_ratio_lag1

		annotation SummarizationSetBy = Automatic

	/// Agricultural output price index, chain-linked across Eurostat bases and rebased to 2020 = 100. Compare levels with the consumer index directly.
	column producer_price_index
